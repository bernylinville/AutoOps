# 项目启动端口
server:
  address: 0.0.0.0:8000
  model: debug
  enableSwagger: true

# 数据库配置
db:
  dialects: postgres
  host: 127.0.0.1
  port: 5432
  db: autoops
  username: devops
  password: your_postgres_password
  charset: utf8
  maxIdle: 50
  maxOpen: 150

# redis配置
redis:
  address: 127.0.0.1:6379
  password: "your_valkey_password"

# 图片地址
imageSettings:
  uploadDir: ./upload/
  imageHost: ""

# log日志配置
log:
  path: ./log
  name: sys
  model: console

# 监控配置
# AutoOps 不再维护内置 Prometheus / Pushgateway。
# 基础主机指标来自已接入的 N9E / VictoriaMetrics，告警通知来自现有 FlashDuty。
monitor:
  agent:
    heartbeat_server_url: "http://127.0.0.1:8000/api/v1/monitor/agent/heartbeat"
    heartbeat_token: "your_heartbeat_token"

# FlashDuty 告警中心配置
flashduty:
  app_key: ""
  integration_key: ""
  base_url: "https://api.flashcat.cloud"
  timeout: 30

# 钉钉告警机器人配置
dingtalk:
  webhook_url: ""

# 钉钉审批卡片配置
dingtalkApproval:
  client_id: ""
  client_secret: ""
  process_code: ""
  originator_dept_id: 0
  microapp_agent_id: 0
  redirect_url: ""
  poll_interval_seconds: 30
  field_mappings:
    request_no: ""
    release_name: ""
    cluster_target: ""
    deploy_mode: ""
    resource_type: ""
    image: ""
    namespace: ""
    ttl_hours: ""
    reason: ""

integrations:
  agent:
    bearer_token: "change-me-agent-token"
    project_onboarding:
      enabled: false
      allowed_git_hosts: []
      shared_jenkins_job_name: ""
      default_business_group_id: 0
      default_business_dept_id: 0
      default_jenkins_server_id: 0
      default_harbor_server_id: 0
      default_harbor_project: ""
      default_approver_admin_id: 0
      dev_cluster_target_id: 0
      test_cluster_target_id: 0
      namespace_prefix: "ao-direct"
      default_service_port: 80
      default_target_port: 8080
  gitops:
    local_checkout_path: "/home/kchou/Code/pukka-gitops"
  deploy_bot:
    provider: dingtalk
    enabled: false
    webhook_url: ""
    secret: ""
  dingtalk:
    inbound:
      enabled: false # v1 feature-flag skeleton (default OFF); set true to enable AutoOps-side inbound parsing (v2 follow-up)
