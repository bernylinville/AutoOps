#!/usr/bin/env bash
set -euo pipefail

# AutoOps Development Bootstrap
# Checks environment readiness for local development

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

check_command() {
    if command -v "$1" &> /dev/null; then
        echo -e "${GREEN}✓${NC} $1 found: $(command -v "$1")"
        return 0
    else
        echo -e "${RED}✗${NC} $1 not found"
        return 1
    fi
}

check_version() {
    local cmd="$1"
    local min_version="$2"
    local version_flag="${3:---version}"
    
    if ! command -v "$cmd" &> /dev/null; then
        return 1
    fi
    
    local version
    version=$("$cmd" "$version_flag" 2>&1 | head -n 1)
    echo -e "${GREEN}✓${NC} $cmd version: $version"
}

echo "================================"
echo "AutoOps Development Bootstrap"
echo "================================"
echo ""

# Check Docker
echo "Checking Docker..."
if check_command "docker"; then
    check_version "docker" "27.0" "--version"
    
    if docker compose version &> /dev/null; then
        echo -e "${GREEN}✓${NC} Docker Compose found"
    else
        echo -e "${RED}✗${NC} Docker Compose not found (install Docker Compose v2)"
        ((ERRORS++))
    fi
else
    ((ERRORS++))
fi

echo ""

# Check Go
echo "Checking Go..."
if check_command "go"; then
    check_version "go" "1.24"
else
    ((ERRORS++))
fi

echo ""

# Check Node.js
echo "Checking Node.js..."
if check_command "node"; then
    check_version "node" "22"
else
    ((ERRORS++))
fi

echo ""

# Check npm
echo "Checking npm..."
if check_command "npm"; then
    check_version "npm" "10"
else
    ((ERRORS++))
fi

echo ""

# Check mise (optional but recommended)
echo "Checking mise (optional)..."
if check_command "mise"; then
    check_version "mise" "latest"
else
    echo -e "${YELLOW}⚠${NC} mise not found (optional, used for version management)"
    ((WARNINGS++))
fi

echo ""

# Check PostgreSQL client (optional)
echo "Checking PostgreSQL client (optional)..."
if check_command "psql"; then
    check_version "psql" "17"
else
    echo -e "${YELLOW}⚠${NC} psql not found (optional, for direct DB access)"
    ((WARNINGS++))
fi

echo ""

# Check kubectl (optional, for K8s management)
echo "Checking kubectl (optional)..."
if check_command "kubectl"; then
    check_version "kubectl" "1.28"
else
    echo -e "${YELLOW}⚠${NC} kubectl not found (optional, for Kubernetes features)"
    ((WARNINGS++))
fi

echo ""
echo "================================"
echo "Bootstrap Summary"
echo "================================"

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${GREEN}All checks passed!${NC} Your environment is ready for AutoOps development."
    echo ""
    echo "Next steps:"
    echo "  1. cd docker && docker compose up -d postgres valkey"
    echo "  2. cd api && cp config.yaml.example config.yaml && go run ."
    echo "  3. cd web && npm install && npm run dev"
elif [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}Required tools ready.${NC} ${YELLOW}$WARNINGS optional tool(s) missing.${NC}"
    echo "You can start development, but some features may be limited."
else
    echo -e "${RED}$ERRORS required tool(s) missing.${NC} ${YELLOW}$WARNINGS optional tool(s) missing.${NC}"
    echo ""
    echo "Please install the required tools above before starting development."
    echo ""
    echo "Quick install suggestions:"
    echo "  - Docker: https://docs.docker.com/get-docker/"
    echo "  - Go: https://go.dev/dl/ or 'mise install go@1.24'"
    echo "  - Node.js: https://nodejs.org/ or 'mise install node@22'"
    exit 1
fi
